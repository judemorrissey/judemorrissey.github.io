---
import BaseLayout from '../layouts/BaseLayout.astro';
import {ThemeToggle} from '../components/ThemeToggle';
---

<BaseLayout>
  <nav class="nav">
    <ThemeToggle client:only="react" />
  </nav>

  <div class="floating-images" aria-hidden="true">
    <div class="float-img img-1"></div>
    <div class="float-img img-2"></div>
    <div class="float-img img-3"></div>
    <div class="float-img img-4"></div>
    <div class="float-img img-5"></div>
  </div>

  <main class="content">
    <section class="hero">
      <div class="name-row">
        <h1 class="name">Jude Morrissey</h1>
        <span class="caret" aria-hidden="true"></span>
      </div>
      <p class="tagline">Software Engineer</p>
      <div class="links">
        <a
          href="https://www.linkedin.com/in/judemorrissey"
          rel="noreferrer noopener"
          target="_blank">
          LinkedIn
        </a>
        <span class="separator" aria-hidden="true">/</span>
        <a
          href="https://www.github.com/judemorrissey"
          rel="noreferrer noopener"
          target="_blank">
          GitHub
        </a>
      </div>
    </section>

    <section class="about">
      <p>
        I like building things that people use. I also enjoy working well with
        others and I believe clean code and good developer experience help
        facilitate such a work environment. Outside of work, I am the king of
        many random hobbies and unfinished projects.
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .nav {
    position: fixed;
    top: var(--size-5);
    right: var(--size-5);
    z-index: 10;
  }

  .content {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--size-7);
    max-width: 640px;
    margin: 0 auto;
    gap: var(--size-9);
  }

  @keyframes drift-in {
    from {
      opacity: 0;
      scale: 0.8;
    }
    to {
      opacity: 0.12;
      scale: 1;
    }
  }

  @keyframes float {
    0%,
    100% {
      translate: var(--drift-x, 0) var(--drift-y, 0);
    }
    50% {
      translate: var(--drift-x, 0) calc(var(--drift-y, 0px) + var(--bob, 12px));
    }
  }

  .floating-images {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .float-img {
    position: absolute;
    border-radius: var(--radius-3);
    opacity: 0;
    animation:
      drift-in 1.2s var(--ease-2) var(--delay) forwards,
      float var(--float-dur, 7s) var(--ease-2) var(--delay) infinite;
  }

  .img-1 {
    --delay: 3s;
    --drift-x: 6px;
    --drift-y: -4px;
    --bob: 14px;
    --float-dur: 7s;
    width: 140px;
    height: 100px;
    top: 10%;
    left: 8%;
    background: linear-gradient(
      135deg,
      var(--color-accent) 0%,
      transparent 80%
    );
    rotate: -6deg;
  }

  .img-2 {
    --delay: 3.3s;
    --drift-x: -8px;
    --drift-y: 6px;
    --bob: -10px;
    --float-dur: 8s;
    width: 120px;
    height: 120px;
    top: 15%;
    right: 10%;
    background: linear-gradient(
      225deg,
      var(--color-accent) 0%,
      transparent 80%
    );
    border-radius: 50%;
    rotate: 4deg;
  }

  .img-3 {
    --delay: 3.6s;
    --drift-x: 10px;
    --drift-y: 4px;
    --bob: 16px;
    --float-dur: 9s;
    width: 160px;
    height: 110px;
    bottom: 18%;
    left: 5%;
    background: linear-gradient(
      45deg,
      var(--color-accent) 0%,
      var(--color-border) 100%
    );
    rotate: 3deg;
  }

  .img-4 {
    --delay: 3.9s;
    --drift-x: -5px;
    --drift-y: -8px;
    --bob: -12px;
    --float-dur: 6.5s;
    width: 100px;
    height: 140px;
    bottom: 20%;
    right: 8%;
    background: linear-gradient(
      315deg,
      var(--color-accent) 0%,
      transparent 80%
    );
    rotate: -4deg;
  }

  .img-5 {
    --delay: 4.2s;
    --drift-x: 4px;
    --drift-y: 6px;
    --bob: 10px;
    --float-dur: 8.5s;
    width: 90px;
    height: 90px;
    top: 50%;
    left: 15%;
    background: linear-gradient(
      180deg,
      var(--color-accent) 0%,
      transparent 70%
    );
    border-radius: 50%;
    rotate: 8deg;
  }

  @keyframes fade-in-up {
    from {
      opacity: 0;
      translate: 0 0.75rem;
    }
  }

  @keyframes type-in {
    from {
      max-width: 0;
    }
    to {
      max-width: 14ch;
    }
  }

  @keyframes blink-caret {
    0%,
    20%,
    40%,
    50%,
    100% {
      opacity: 1;
    }
    10%,
    30% {
      opacity: 0;
    }
  }

  @keyframes fade-out {
    to {
      opacity: 0;
    }
  }

  .hero {
    text-align: center;
  }

  .name {
    font-family: 'JetBrains Mono', monospace;
    font-size: var(--font-size-7);
    font-weight: var(--font-weight-7);
    margin: 0;
    color: var(--color-text);
    white-space: nowrap;
    display: inline-block;
    overflow: hidden;
    animation: type-in 1s steps(14) 1s both;
  }

  .name-row {
    position: relative;
    display: inline-block;
  }

  .caret {
    position: absolute;
    right: -0.3ch;
    top: 50%;
    translate: 100% -50%;
    width: 0.6ch;
    height: 1em;
    font-family: 'JetBrains Mono', monospace;
    font-size: var(--font-size-7);
    background-color: var(--color-text);
    animation:
      blink-caret 2.5s steps(1) both,
      fade-out 0.3s var(--ease-2) 2.5s forwards;
  }

  .tagline {
    font-size: var(--font-size-3);
    color: var(--color-text-muted);
    margin: var(--size-2) 0 0;
    animation: fade-in-up 0.6s var(--ease-2) 2s both;
  }

  .links {
    margin-top: var(--size-5);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    font-size: var(--font-size-2);
    animation: fade-in-up 0.6s var(--ease-2) 2.15s both;
  }

  .separator {
    color: var(--color-text-muted);
  }

  .about {
    text-align: center;
    animation: fade-in-up 0.6s var(--ease-2) 2.3s both;
  }

  .about p {
    color: var(--color-text-muted);
    line-height: var(--font-lineheight-4);
    margin: 0;
    font-size: var(--font-size-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .name,
    .tagline,
    .links,
    .about,
    .float-img {
      animation: none;
    }

    .float-img {
      opacity: 0.08;
    }

    .name {
      max-width: none;
    }

    .caret {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .name {
      font-size: 2.25rem;
    }

    .content {
      padding: var(--size-5);
      gap: var(--size-8);
    }

    .floating-images {
      display: none;
    }
  }
</style>
