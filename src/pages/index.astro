---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle';
---

<BaseLayout>
  <nav class="nav">
    <ThemeToggle client:only="react" />
  </nav>

  <main class="content">
    <section class="hero">
      <h1 class="name" aria-label="Jude Morrissey"><span
          class="initial"
          aria-hidden="true">J</span><span
          class="rest"
          aria-hidden="true">ude Morrissey</span></h1>
      <p class="tagline">Software Engineer</p>
      <div class="links">
        <a
          href="https://www.linkedin.com/in/judemorrissey"
          rel="noreferrer noopener"
          target="_blank">
          LinkedIn
        </a>
        <span class="separator" aria-hidden="true">/</span>
        <a
          href="https://www.github.com/judemorrissey"
          rel="noreferrer noopener"
          target="_blank">
          GitHub
        </a>
      </div>
    </section>

    <section class="about">
      <h2 class="section-heading">About</h2>
      <p>
        I'm a software engineer who enjoys building things for the web. I care
        about clean code, good developer experience, and making software that
        people actually want to use.
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .nav {
    position: fixed;
    top: var(--size-5);
    right: var(--size-5);
    z-index: 10;
  }

  .content {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--size-7);
    max-width: 640px;
    margin: 0 auto;
    gap: var(--size-9);
  }

  @keyframes fade-in-up {
    from {
      opacity: 0;
      translate: 0 0.75rem;
    }
  }

  @keyframes shrink-initial {
    from {
      font-size: 2em;
    }
  }

  @keyframes type-in {
    from {
      max-width: 0;
    }
    to {
      max-width: 13ch;
    }
  }

  .hero {
    text-align: center;
  }

  .name {
    font-size: var(--font-size-7);
    font-weight: var(--font-weight-7);
    margin: 0;
    color: var(--color-text);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .initial {
    display: inline;
    animation: shrink-initial 0.7s var(--ease-2) 0.4s backwards;
  }

  .rest {
    display: inline-block;
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    vertical-align: text-top;
    animation: type-in 0.8s steps(13) 1.1s both;
  }

  .tagline {
    font-size: var(--font-size-3);
    color: var(--color-text-muted);
    margin: var(--size-2) 0 0;
    animation: fade-in-up 0.6s var(--ease-2) 2s both;
  }

  .links {
    margin-top: var(--size-5);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    font-size: var(--font-size-2);
    animation: fade-in-up 0.6s var(--ease-2) 2.15s both;
  }

  .separator {
    color: var(--color-text-muted);
  }

  .about {
    text-align: center;
    animation: fade-in-up 0.6s var(--ease-2) 2.3s both;
  }

  .section-heading {
    font-size: var(--font-size-4);
    font-weight: var(--font-weight-6);
    margin: 0 0 var(--size-3);
    color: var(--color-text);
  }

  .about p {
    color: var(--color-text-muted);
    line-height: var(--font-lineheight-4);
    margin: 0;
    font-size: var(--font-size-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .initial,
    .rest,
    .tagline,
    .links,
    .about {
      animation: none;
    }

    .rest {
      max-width: none;
    }
  }

  @media (max-width: 480px) {
    .name {
      font-size: 2.25rem;
    }

    .content {
      padding: var(--size-5);
      gap: var(--size-8);
    }
  }
</style>
