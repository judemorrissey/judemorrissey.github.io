---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle';
---

<BaseLayout>
  <nav class="nav">
    <ThemeToggle client:only="react" />
  </nav>

  <main class="content">
    <section class="hero">
      <div class="name-row">
        <h1 class="name">Jude Morrissey</h1>
        <span class="caret" aria-hidden="true"></span>
      </div>
      <p class="tagline">Software Engineer</p>
      <div class="links">
        <a
          href="https://www.linkedin.com/in/judemorrissey"
          rel="noreferrer noopener"
          target="_blank">
          LinkedIn
        </a>
        <span class="separator" aria-hidden="true">/</span>
        <a
          href="https://www.github.com/judemorrissey"
          rel="noreferrer noopener"
          target="_blank">
          GitHub
        </a>
      </div>
    </section>

    <section class="about">
      <h2 class="section-heading">About</h2>
      <p>
        I'm a software engineer who enjoys building things for the web. I care
        about clean code, good developer experience, and making software that
        people actually want to use.
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .nav {
    position: fixed;
    top: var(--size-5);
    right: var(--size-5);
    z-index: 10;
  }

  .content {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--size-7);
    max-width: 640px;
    margin: 0 auto;
    gap: var(--size-9);
  }

  @keyframes fade-in-up {
    from {
      opacity: 0;
      translate: 0 0.75rem;
    }
  }

  @keyframes type-in {
    from {
      max-width: 0;
    }
    to {
      max-width: 14ch;
    }
  }

  @keyframes blink-caret {
    0%, 20%, 40%, 50%, 100% {
      opacity: 1;
    }
    10%, 30% {
      opacity: 0;
    }
  }

  @keyframes fade-out {
    to {
      opacity: 0;
    }
  }

  .hero {
    text-align: center;
  }

  .name {
    font-family: 'JetBrains Mono', monospace;
    font-size: var(--font-size-7);
    font-weight: var(--font-weight-7);
    margin: 0;
    color: var(--color-text);
    white-space: nowrap;
    display: inline-block;
    overflow: hidden;
    animation: type-in 1s steps(14) 1s both;
  }

  .name-row {
    position: relative;
    display: inline-block;
  }

  .caret {
    position: absolute;
    right: -0.3ch;
    top: 50%;
    translate: 100% -50%;
    width: 0.6ch;
    height: 1em;
    font-family: 'JetBrains Mono', monospace;
    font-size: var(--font-size-7);
    background-color: var(--color-text);
    animation:
      blink-caret 2.5s steps(1) both,
      fade-out 0.3s var(--ease-2) 2.5s forwards;
  }

  .tagline {
    font-size: var(--font-size-3);
    color: var(--color-text-muted);
    margin: var(--size-2) 0 0;
    animation: fade-in-up 0.6s var(--ease-2) 2s both;
  }

  .links {
    margin-top: var(--size-5);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    font-size: var(--font-size-2);
    animation: fade-in-up 0.6s var(--ease-2) 2.15s both;
  }

  .separator {
    color: var(--color-text-muted);
  }

  .about {
    text-align: center;
    animation: fade-in-up 0.6s var(--ease-2) 2.3s both;
  }

  .section-heading {
    font-size: var(--font-size-4);
    font-weight: var(--font-weight-6);
    margin: 0 0 var(--size-3);
    color: var(--color-text);
  }

  .about p {
    color: var(--color-text-muted);
    line-height: var(--font-lineheight-4);
    margin: 0;
    font-size: var(--font-size-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .name,
    .tagline,
    .links,
    .about {
      animation: none;
    }

    .name {
      max-width: none;
    }

    .caret {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .name {
      font-size: 2.25rem;
    }

    .content {
      padding: var(--size-5);
      gap: var(--size-8);
    }
  }
</style>
